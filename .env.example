# Copy to .env and fill in. Never commit the real .env.

# Required — sign JWTs with a random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# SQLite by default; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tickets
DATABASE_URL=sqlite:///./ticket_system.db

# Token lifetime and login rate limit
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT=10/minute
# Set to false to disable login rate limiting (tests do this automatically)
RATE_LIMIT_ENABLED=true

# Email notifications (optional — without a key, emails are logged, not sent)
SENDGRID_API_KEY=
EMAIL_FROM=tickets@example.com

# Seed script: set both to create/promote an admin, then run  python -m app.seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated origins for a separately-hosted frontend (production)
CORS_ORIGINS=
